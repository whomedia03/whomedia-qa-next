{
 "buildCommand": "pnpm build", "outputDirectory": "dist", "framework": "vite",
 "functions": { "api/index.ts": { "maxDuration": 300 } },
 "rewrites": [{ "source": "/api", "destination": "/api/index" }, { "source": "/admin", "destination": "/index.html" }],
 "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Frame-Options", "value": "DENY" }] }]
}
